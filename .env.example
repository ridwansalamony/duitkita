# live = Supabase; demo = data Budi & Sari untuk pratinjau/regresi lokal.
NEXT_PUBLIC_APP_MODE=live
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DuitKita

# Supabase Auth, PostgreSQL, dan Storage (Fase 2)
NEXT_PUBLIC_SUPABASE_URL=
# Gunakan publishable key; anon key lama tetap didukung sebagai alternatif.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Session Pooler port 5432 bila koneksi langsung IPv6 tidak tersedia.
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_RECEIPT_BUCKET=receipts

# OCR Tesseract.js berjalan di browser; tidak memerlukan API key.

# Pembatas request memakai memori per instance tanpa layanan tambahan.