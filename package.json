{
  "name": "duitkita",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-ocr.mjs && next dev --hostname 0.0.0.0",
    "build": "node scripts/prepare-ocr.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/database.mts --migrate",
    "db:check": "tsx scripts/database.mts",
    "test:db": "tsx scripts/test-database.mts",
    "ocr:prepare": "node scripts/prepare-ocr.mjs",
    "check:production": "node scripts/check-production.mjs",
    "clean": "node scripts/clean.mjs",
    "test:security": "playwright test tests/upload-security.spec.ts tests/tooling-security.spec.ts tests/rate-limit.spec.ts tests/identity-boundary.spec.ts",
    "postinstall": "node scripts/secure-tooling.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/ind": "^1.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^12.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "overrides": {
    "jspdf": {
      "dompurify": "^3.4.17"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    },
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2"
  },
  "allowScripts": {
    "unrs-resolver": true,
    "sharp": true,
    "esbuild": true,
    "tesseract.js": false,
    "core-js": false
  }
}
